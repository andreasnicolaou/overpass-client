{
  "name": "@andreasnicolaou/overpass-client",
  "version": "1.5.0",
  "description": "A wrapper for the Overpass API to query OpenStreetMap data.",
  "main": "./dist/index.cjs",
  "private": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.min.js",
  "jsdelivr": "./dist/index.umd.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:bundles && npm run clean:tmp",
    "build:types": "tsc -p tsconfig.build.json",
    "build:bundles": "rollup -c",
    "clean": "node -e \"for (const d of ['dist','.types-tmp']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "clean:tmp": "node -e \"require('node:fs').rmSync('.types-tmp',{recursive:true,force:true})\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:ci": "cross-env JEST_JUNIT_CLASSNAME=\"{filepath}\" jest --reporters=default --reporters=jest-junit",
    "test:bundle": "npx bundlewatch"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andreasnicolaou/overpass-client.git"
  },
  "bugs": {
    "url": "https://github.com/andreasnicolaou/overpass-client/issues"
  },
  "author": "Andreas Nicolaou <anicolaou66@gmail.com>",
  "license": "MIT",
  "jest": {
    "transform": {
      "^.+\\.(ts)$": [
        "ts-jest"
      ]
    },
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  },
  "bundlewatch": {
    "files": [
      {
        "path": "dist/index.js",
        "maxSize": "3.5kB",
        "compression": "gzip"
      },
      {
        "path": "dist/index.cjs",
        "maxSize": "3.5kB",
        "compression": "gzip"
      },
      {
        "path": "dist/index.umd.min.js",
        "maxSize": "33kB",
        "compression": "gzip"
      }
    ]
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.68.0",
    "axios-mock-adapter": "^2.1.0",
    "bundlewatch": "^0.4.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.9.0",
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "prettier": "3.9.6",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "overpass",
    "openstreetmap",
    "api",
    "osm",
    "geospatial",
    "data-query",
    "map",
    "andreasnicolaou"
  ],
  "dependencies": {
    "@types/node": "^26.2.0",
    "axios": "^1.19.0",
    "lru-cache": "^11.5.2",
    "rxjs": "^7.8.2"
  }
}
